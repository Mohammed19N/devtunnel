# /etc/passway/env: read by systemd (EnvironmentFile=) and by
# `docker compose --env-file /etc/passway/env`. Keep it root-owned, mode 0600.
# Quote values that contain spaces. PASSWAY_MODE=cloud is set by the unit and
# by compose.yaml, so it is not set here.

# --- Settings (passed as flags by deploy/systemd/passway-server.service) ---

# The base domain. Tunnels are <name>.<domain>, the dashboard is
# https://<domain>, and custom domains CNAME to edge.<domain>.
PASSWAY_DOMAIN=passway.example
# Let's Encrypt account email.
PASSWAY_ACME_EMAIL=ops@passway.example
# GitHub OAuth app client ID. Its callback URL is
# https://<domain>/auth/github/callback.
PASSWAY_GITHUB_CLIENT_ID=
# Stripe price ID of the Pro plan (price_...). Leave it, PASSWAY_STRIPE_SECRET_KEY
# and PASSWAY_STRIPE_WEBHOOK_SECRET all empty to run without billing. Setting
# only some of the three is a startup error.
PASSWAY_STRIPE_PRICE_PRO=
# Numeric GitHub user IDs allowed to open /admin, comma-separated. These are
# IDs, not logins: see https://api.github.com/users/<login>.
PASSWAY_ADMIN_GITHUB_IDS=
# Named on /terms, /privacy and /aup. Empty renders "the operator of this service".
PASSWAY_LEGAL_OPERATOR=""
PASSWAY_LEGAL_JURISDICTION=""
# Empty means abuse@<domain>.
PASSWAY_ABUSE_EMAIL=

# --- Secrets (read from the environment by passway-server itself) ---

PASSWAY_GITHUB_CLIENT_SECRET=
PASSWAY_STRIPE_SECRET_KEY=
PASSWAY_STRIPE_WEBHOOK_SECRET=
# Cloudflare API token with Zone.DNS:Edit on the domain's zone. It is used
# for the DNS-01 challenge of the wildcard certificate.
PASSWAY_CLOUDFLARE_API_TOKEN=
